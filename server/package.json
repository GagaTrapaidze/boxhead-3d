{
  "name": "@game-shoot/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authoritative game server (Colyseus lobby + CoopRoom)",
  "scripts": {
    "dev": "node --experimental-strip-types --watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "esbuild": "^0.21.5"
  },
  "dependencies": {
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "^0.16.5",
    "colyseus": "^0.16.5"
  }
}
