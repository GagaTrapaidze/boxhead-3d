# Base WebSocket URL of the authoritative game server.
#
# Local dev  → the Phase 0 scaffold:        ws://localhost:2567
# Production → your Render service URL:     wss://game-shoot-server.onrender.com
#
# Vite inlines VITE_* vars at build time, so set this in the deploy environment
# (Vercel → Project → Settings → Environment Variables) as well as locally.
VITE_SERVER_URL=ws://localhost:2567
